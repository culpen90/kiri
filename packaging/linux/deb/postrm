#!/bin/sh
# stowlark.deb: after the files are gone. Images, containers and volumes stay in
# /var/lib/stowlark and /var/lib/stowlark-daemon unless the package is purged.
set -e
case "$1" in
  remove)
    [ -d /run/systemd/system ] && systemctl daemon-reload || true
    echo "Stowlark is removed; its images, containers and volumes stay in /var/lib/stowlark (apt purge stowlark deletes them)"
    ;;
  purge)
    # Anything still mounted under the data directory (a container's rootfs
    # or volume from an engine that was not stopped cleanly) is unmounted
    # first, deepest first, so rm does not reach through a mount into the
    # live filesystem it came from; --one-file-system is the second guard.
    if command -v findmnt >/dev/null; then
      findmnt -lrno TARGET 2>/dev/null | grep -E "^/var/lib/stowlark(/|$)" | tac | xargs -r -n1 umount 2>/dev/null || true
    fi
    rm -rf --one-file-system /var/lib/stowlark /var/lib/stowlark-daemon /run/stowlark
    getent group stowlark >/dev/null && groupdel stowlark || true
    ;;
esac
exit 0
