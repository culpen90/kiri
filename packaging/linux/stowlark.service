# Stowlark on a Linux host, as the .deb and .rpm install it: containers on this
# machine's kernel, no VM. Users in the `stowlark` group reach the API at
# unix:///run/stowlark/docker.sock:
#   docker context create stowlark --docker host=unix:///run/stowlark/docker.sock
# and, while no Docker engine has it, at /var/run/docker.sock too.
[Unit]
Description=Stowlark container engine
Documentation=https://github.com/stowlark/stowlark
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/stowlark daemon
Environment=STOWLARK_SOCKET=/run/stowlark/docker.sock
Environment=STOWLARK_SOCKET_GROUP=stowlark
Environment=HOME=/var/lib/stowlark-daemon
# The daemon creates the cgroups its containers run in.
Delegate=yes
KillMode=mixed
Restart=on-failure
# Tools that ignore docker contexts (docker-py, Go's client.FromEnv,
# docker-java, Testcontainers, IDE plugins) look for /var/run/docker.sock
# (/run/docker.sock): when nothing is there, it links to Stowlark's socket, whose
# 0660 root:stowlark is what counts. Docker's docker.socket or dockerd replaces
# a link when it starts, so Docker keeps the path whenever it runs, and the
# link goes when Stowlark stops, if it is still Stowlark's.
ExecStartPost=-/bin/sh -c '[ "$$(readlink /run/docker.sock)" = /run/stowlark/docker.sock ] || [ -e /run/docker.sock ] || [ -L /run/docker.sock ] || ln -s /run/stowlark/docker.sock /run/docker.sock'
ExecStopPost=-/bin/sh -c '[ "$$(readlink /run/docker.sock)" != /run/stowlark/docker.sock ] || rm -f /run/docker.sock'
RuntimeDirectory=stowlark
# 0755: members of stowlark reach the socket (itself 0660 root:stowlark) through it.
RuntimeDirectoryMode=0755
StateDirectory=stowlark-daemon
StateDirectoryMode=0700
# What the daemon writes is for root and the stowlark group only (/var/lib/stowlark
# itself is 0710: stowlark-init sets that, and its own umask, when it starts).
UMask=0027

[Install]
WantedBy=multi-user.target
