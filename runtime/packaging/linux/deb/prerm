#!/bin/sh
# stowlark / stowlark-lite .deb: before the files go. Stops the engine (containers it
# ran stop with it) and withdraws Stowlark's docker CLI from PATH.
set -e
# Removing Stowlark stops everything it runs: the engine (above, which stops its
# containers), and any window or stowlark command still open from this package
# (`stowlark share`, `stowlark ui`), first asked to quit, then made to.
stop_everything() {
  for sig in TERM KILL; do
    pkill -"$sig" -f '^/usr/lib/stowlark/stowlark-window( |$)' 2>/dev/null || true
    pkill -"$sig" -f '^(/usr)?/bin/stowlark( |$)' 2>/dev/null || true
    [ "$sig" = KILL ] || sleep 1
  done
}
case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl disable --now stowlark.service || true
    fi
    stop_everything
    if [ -x /usr/libexec/stowlark/docker ]; then
      update-alternatives --remove docker /usr/libexec/stowlark/docker || true
      for p in docker-compose docker-buildx; do
        update-alternatives --remove "$p" "/usr/libexec/stowlark/cli-plugins/$p" || true
      done
    fi
    ;;
esac
exit 0
