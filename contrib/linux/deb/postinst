#!/bin/sh
# Stowlark's engine as a system service; whoever ran apt joins the stowlark group
# and gets the stowlark docker context.
set -e
if [ "$1" = configure ]; then
    getent group stowlark >/dev/null || addgroup --system stowlark
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ] && id "$SUDO_USER" >/dev/null 2>&1; then
        adduser "$SUDO_USER" stowlark >/dev/null || true
        # The CLI's context, made as that person so it lands in their ~/.docker.
        su - "$SUDO_USER" -c 'docker context inspect stowlark >/dev/null 2>&1 || docker context create stowlark --docker host=unix:///run/stowlark/docker.sock >/dev/null' || true
        su - "$SUDO_USER" -c 'docker context use stowlark >/dev/null' || true
        echo "Stowlark: $SUDO_USER is in the stowlark group. Log out and back in once for it to apply."
    else
        echo "Stowlark: add yourself to the stowlark group (sudo adduser \$USER stowlark), then log out and back in."
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable stowlark.service >/dev/null 2>&1 || true
        systemctl restart stowlark.service || true
    fi
fi
exit 0
